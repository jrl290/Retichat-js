# Copy to deploy.env (gitignored) and fill in. deploy.sh sources it for you.
#
# Leave RETICHAT_SSH_PASS empty and install an SSH key on the node instead —
# deploy.sh falls back to key auth with BatchMode, which drops the sshpass
# dependency and keeps the password out of your shell history.

export RETICHAT_SSH_HOST="retichat@retichat.com"
export RETICHAT_SSH_PASS=""

# verify-deploy.sh needs no credentials. Override only if the client is served
# from somewhere other than https://retichat.com.
# export RETICHAT_WEB_URL="https://retichat.com"

export SELECTIV_SSH_HOST="selectiv@selectivesubconscious.com"
export SELECTIV_SSH_PASS=""
